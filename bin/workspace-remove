#!/bin/sh
# Usage: workspace-remove < hook-json
#
# A Claude Code WorktreeRemove hook for the workspaces that workspace-create
# makes. It reads worktree_path from the JSON on stdin. It exits 1 and
# leaves the workspace in place while any repo in it has uncommitted
# changes, or a commit that no remote branch and no other local branch has.
# Otherwise it removes every worktree, nested ones first, and deletes the
# local branches. Claude Code never deletes a branch of a hook-made
# worktree, so this script must.
set -eu

ws=$(jq -r .worktree_path)
[ -d "$ws" ] || exit 0
name=$(basename "$ws")
list=$(mktemp)
trap 'rm -f "$list"' EXIT

# One line per worktree in the workspace, "DIR MAIN", nested ones first.
# MAIN is the checkout the worktree is linked from.
for d in "$ws"/workspace/*/ "$ws/"; do
    d=${d%/}
    [ -f "$d/.git" ] || continue
    main=$(dirname "$(git -C "$d" rev-parse --path-format=absolute --git-common-dir)")
    printf '%s %s\n' "$d" "$main" >>"$list"
done

# Count the commits of REV in DIR that are on no remote branch and on no
# local branch other than $name.
unsaved() {
    git -C "$1" for-each-ref --format='%(refname)' refs/heads refs/remotes |
        grep -vxF "refs/heads/$name" |
        sed 's/^/^/' |
        git -C "$1" rev-list --count "$2" --stdin
}

# Check every tree before removing any.
while read -r dir main; do
    if [ -n "$(git -C "$dir" status --porcelain)" ]; then
        echo "workspace-remove: $dir has uncommitted changes; workspace kept" >&2
        exit 1
    fi
    for rev in HEAD "refs/heads/$name"; do
        git -C "$dir" rev-parse --verify --quiet "$rev" >/dev/null || continue
        n=$(unsaved "$dir" "$rev")
        if [ "$n" -gt 0 ]; then
            echo "workspace-remove: $dir has $n commits on $rev that are not pushed or merged; workspace kept" >&2
            exit 1
        fi
    done
done <"$list"

while read -r dir main; do
    git -C "$main" worktree remove --force "$dir" >&2
    git -C "$main" show-ref --verify --quiet "refs/heads/$name" &&
        git -C "$main" branch -D "$name" >&2
done <"$list"
exit 0
