#!/bin/sh
# Usage: workspace-create < hook-json
#
# A Claude Code WorktreeCreate hook. An agent repo names this script in its
# .claude/settings.json; see "Session workspaces" in the README. It reads the
# worktree name from the JSON on stdin and prints the workspace path on the
# last line of stdout. The workspace is a worktree of the agent repo at
# .claude/worktrees/NAME on branch NAME, plus a worktree of each repo in the
# agent repo's .claude/workspace-repos at workspace/DIR, on branch NAME of
# that repo.
#
# A line of .claude/workspace-repos is "DIR PATH [LINK...]", split at
# whitespace, so no field can hold a space. DIR is one path component. PATH
# is the shared clone and may start with ~/. Each LINK is a gitignored path
# that is symlinked from the shared clone into the new worktree. A line whose
# PATH is not a clone with a commit, or whose DIR is not one component, gets
# a warning and no worktree.
#
# It exits non-zero, before it makes anything, when NAME is not a branch name
# git accepts or when branch NAME is checked out somewhere else. Safe to run
# again for the same name: it reuses the branches and worktrees that exist.
set -eu

name=$(jq -r .name)
case $name in
'' | null | HEAD | @ | .* | -* | */* | *@{* | *[[:space:]]*) name_ok=false ;;
*) git check-ref-format --branch "$name" >/dev/null 2>&1 && name_ok=true || name_ok=false ;;
esac
if [ "$name_ok" = false ]; then
    echo "workspace-create: bad name '$name'" >&2
    exit 1
fi

# The main checkout, also when this runs from inside a workspace.
root=$(dirname "$(git -C "${CLAUDE_PROJECT_DIR:-.}" rev-parse --path-format=absolute --git-common-dir)")
ws=$root/.claude/worktrees/$name

# Print the worktree of REPO that has branch $name checked out, if any.
holder() {
    git -C "$1" worktree list --porcelain |
        awk -v b="branch refs/heads/$name" '/^worktree /{w=substr($0,10)} $0==b{print w}'
}

# Exit 1 when branch $name of REPO is checked out anywhere but DEST. Git
# would refuse the worktree later, with half a workspace already made.
check_free() {
    repo=$1
    dest=$2
    [ -e "$dest/.git" ] && return 0
    held=$(holder "$repo")
    if [ -n "$held" ] && [ ! -e "$held" ]; then
        # The record of a worktree that was deleted by hand.
        git -C "$repo" worktree prune
        held=$(holder "$repo")
    fi
    [ -z "$held" ] && return 0
    echo "workspace-create: branch $name of $repo is checked out at $held; pick another name" >&2
    exit 1
}

# Make branch $name in REPO if it is missing, and mark it with the ref
# refs/workspace/$name so that workspace-remove deletes it and leaves a
# branch that was there before. A ref has its own lock, so two sessions that
# start together do not collide, as they would on git config. In a repo with
# a remote the base is origin/$name when an earlier workspace pushed it, else
# the remote's default branch, else origin/main or origin/master. With no
# remote, or none of those, it is HEAD.
ensure_branch() {
    repo=$1
    if git -C "$repo" show-ref --verify --quiet "refs/heads/$name"; then
        # The branch is here with no worktree on it. Whoever made it, it is
        # kept from now on: drop a marker that an earlier workspace left.
        git -C "$repo" update-ref -d "refs/workspace/$name"
        return 0
    fi
    base=HEAD
    if git -C "$repo" remote get-url origin >/dev/null 2>&1; then
        # A slow remote must not hold up the session; macOS has no timeout.
        if command -v timeout >/dev/null 2>&1; then
            GIT_TERMINAL_PROMPT=0 timeout 10 git -C "$repo" fetch --quiet origin >&2
        else
            GIT_TERMINAL_PROMPT=0 git -C "$repo" fetch --quiet origin >&2
        fi || echo "workspace-create: fetch failed in $repo; using cached refs" >&2
        for ref in "refs/remotes/origin/$name" \
            "$(git -C "$repo" symbolic-ref -q refs/remotes/origin/HEAD || true)" \
            refs/remotes/origin/main refs/remotes/origin/master; do
            [ -n "$ref" ] || continue
            if git -C "$repo" show-ref --verify --quiet "$ref"; then
                base=$ref
                break
            fi
        done
    fi
    git -C "$repo" branch --no-track "$name" "$base" >&2
    git -C "$repo" update-ref "refs/workspace/$name" "refs/heads/$name"
}

# Make a worktree of REPO at DEST on branch $name, unless DEST is one already.
ensure_worktree() {
    repo=$1
    dest=$2
    [ -e "$dest/.git" ] && return 0
    ensure_branch "$repo"
    # git can trip over another session's half-written worktree record when
    # several sessions start together; a second try a moment later works.
    git -C "$repo" worktree add "$dest" "$name" >&2 || {
        sleep 1
        git -C "$repo" worktree add "$dest" "$name" >&2
    }
}

# Symlink LINK from the shared clone REPO into its worktree DEST. git ignores
# "dir/" patterns for a symlink, so the link also goes in the clone's
# info/exclude, or the worktree would never look clean.
ensure_link() {
    repo=$1
    dest=$2
    link=$3
    [ -e "$repo/$link" ] || return 0
    if [ ! -e "$dest/$link" ] && [ ! -L "$dest/$link" ]; then
        ln -s "$repo/$link" "$dest/$link" || {
            echo "workspace-create: could not link $link into $dest" >&2
            return 0
        }
    fi
    exclude=$(git -C "$repo" rev-parse --path-format=absolute --git-common-dir)/info/exclude
    mkdir -p "$(dirname "$exclude")"
    grep -qxF "/$link" "$exclude" 2>/dev/null && return 0
    # Start a new line when the file does not end in one.
    if [ -s "$exclude" ] && [ -n "$(tail -c 1 "$exclude")" ]; then
        echo >>"$exclude"
    fi
    echo "/$link" >>"$exclude"
}

# The usable lines of the list, with ~/ expanded, as DIR, PATH, and the
# LINKs, separated by tabs so that a space in $HOME survives.
entries=$(mktemp)
trap 'rm -f "$entries" "$entries.raw"' EXIT
list=$root/.claude/workspace-repos
if [ -f "$list" ]; then
    grep -Ev '^[[:space:]]*(#|$)' "$list" >"$entries.raw" || true
    while read -r dir path links; do
        case $path in "~/"*) path=$HOME/${path#"~/"} ;; esac
        case $dir in
        */* | . | ..)
            echo "workspace-create: DIR '$dir' is not one path component; skipped" >&2
            continue
            ;;
        esac
        if [ ! -d "$path/.git" ] || ! git -C "$path" rev-parse --verify --quiet HEAD >/dev/null; then
            echo "workspace-create: $path is not a git clone with a commit; no workspace/$dir" >&2
            continue
        fi
        if cut -f1 "$entries" | grep -qxF "$dir" || cut -f2 "$entries" | grep -qxF "$path"; then
            echo "workspace-create: $dir or $path is listed twice; the later line is skipped" >&2
            continue
        fi
        printf '%s\t%s\t%s\n' "$dir" "$path" "$links" >>"$entries"
    done <"$entries.raw"
fi

# Check every repo before making anything.
tab=$(printf '\t')
check_free "$root" "$ws"
while IFS=$tab read -r dir path links; do
    check_free "$path" "$ws/workspace/$dir"
done <"$entries"

ensure_worktree "$root" "$ws"
while IFS=$tab read -r dir path links; do
    ensure_worktree "$path" "$ws/workspace/$dir"
    for link in $links; do
        ensure_link "$path" "$ws/workspace/$dir" "$link"
    done
done <"$entries"

echo "$ws"
